# ========================
# Quantum Trade AI — ENV
# ========================

# Application
APP_NAME=Quantum Trade AI
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database
POSTGRES_DB=quantumtrade
POSTGRES_USER=quantum
POSTGRES_PASSWORD=quantum_secure_pass
DATABASE_URL=postgresql+asyncpg://quantum:quantum_secure_pass@localhost:5432/quantumtrade
DATABASE_SYNC_URL=postgresql://quantum:quantum_secure_pass@localhost:5432/quantumtrade

# Redis
REDIS_PASSWORD=redis_secure_pass
REDIS_URL=redis://:redis_secure_pass@localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@quantumtrade.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Frontend URL (for CORS & password reset links)
FRONTEND_URL=http://localhost:3000

# Market Data API (CoinGecko, Binance)
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
COINGECKO_API_KEY=your-coingecko-api-key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
